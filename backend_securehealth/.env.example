NODE_ENV=development
PORT=12000
API_PREFIX=/api/v1
MONGODB_URI=mongodb://127.0.0.1:27017/securehealth
# Production should use a separately credentialed database/account for signed checkpoints.
CHECKPOINT_MONGODB_URI=mongodb://127.0.0.1:27017/securehealth_checkpoints
MONGODB_TLS=false
REDIS_URL=redis://127.0.0.1:6379
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=false
REQUEST_TIMEOUT_MS=10000
MAX_CONCURRENT_REQUESTS=100
MAX_CONCURRENT_SESSIONS=5

# Replace every development value before a production start.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# 32 random bytes, base64-encoded.
ENCRYPTION_KEY_BASE64=
ENCRYPTION_KEY_ID=securehealth-primary-v1

# Base64-encoded PEM Ed25519 keys. Production requires both values.
AUDIT_SIGNING_PRIVATE_KEY_BASE64=
AUDIT_SIGNING_PUBLIC_KEY_BASE64=
AUDIT_CHECKPOINT_INTERVAL=100
EMAIL_FROM=security@securehealth.invalid
EMAIL_VERIFICATION_TTL_MINUTES=30

# Set only for explicit academic demo environments.
ALLOW_DEMO_TAMPER=false
